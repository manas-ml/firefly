# --- Telegram ---------------------------------------------------------------
# From @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (ask @userinfobot). Comma-separate several.
TELEGRAM_ALLOWED_USER_IDS=

# --- Model ------------------------------------------------------------------
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
MODEL=deepseek/deepseek-v4.1-flash

# --- Secrets for the stack (generate with: openssl rand -hex 32) -----------
SANDBOX_TOKEN=
POSTGRES_PASSWORD=

# --- Behaviour --------------------------------------------------------------
# Give the sandbox internet access (applied by `make up`). Default: offline.
SANDBOX_INTERNET=false
APPROVAL_TIMEOUT_SECONDS=600
TOOL_TIMEOUT_SECONDS=120
MAX_TOOL_OUTPUT_CHARS=20000
LOG_LEVEL=info
TZ=America/Toronto

# Host port for the health endpoint (bound to 127.0.0.1 only).
HEALTH_PORT=8080

# Set by docker-compose.yml; only needed when running the agent outside Docker.
# DATABASE_URL=postgres://firefly:PASSWORD@localhost:5432/firefly
# SANDBOX_URL=http://localhost:7070
