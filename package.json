    "@modelcontextprotocol/sdk": "1.32.2",
    "cron-parser": "^5.10.6",
    "cronstrue": "^3.41.0",
    "fastify": "^5.12.8",
    "grammy": "^1.46.0",
    "libsodium-wrappers": "0.8.4",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.2",
    "pino": "^10.4.0",
